# Backend อ่าน/เขียนได้ทุกหัวข้อ
user iot_backend
topic readwrite univ/parking/#

# อุปกรณ์ ESP32 ทุกตัว
pattern write univ/parking/slots/+/telemetry
pattern read  univ/parking/slots/+/state
pattern read  univ/parking/slots/+/cmd

# สำหรับแต่ละ device ใช้ชื่อ user = esp32-<ID> แล้วได้สิทธิ์เข้าหัวข้อเฉพาะตัวเอง
pattern write univ/parking/devices/%u/access
pattern read  univ/parking/devices/%u/cmd
pattern write univ/parking/devices/%u/status
